{
  "name": "dhwani",
  "productName": "Dhwani",
  "version": "0.10.2",
  "description": "Cross-platform voice dictation and chat client",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compile:globe": "node scripts/build-globe-listener.js",
    "compile:fast-paste": "node scripts/build-macos-fast-paste.js",
    "compile:winkeys": "node scripts/build-windows-key-listener.js",
    "compile:linuxkeys": "node scripts/build-linux-key-listener.js",
    "compile:text-monitor": "node scripts/build-text-monitor.js",
    "compile:winpaste": "node scripts/build-windows-fast-paste.js",
    "compile:linux-paste": "node scripts/build-linux-fast-paste.js",
    "compile:linux-system-audio": "node scripts/build-linux-system-audio.js",
    "compile:media-remote": "node scripts/build-media-remote.js",
    "compile:mic-listener": "node scripts/build-macos-mic-listener.js",
    "compile:audio-tap": "node scripts/build-macos-audio-tap.js",
    "compile:wincopy": "node scripts/build-windows-copy-selection.js",
    "compile:native": "concurrently -n globe,fastpaste,winkeys,linuxkeys,winpaste,linuxpaste,linuxaudio,textmon,mediaremote,miclistener,audiotap,wincopy \"npm run compile:globe\" \"npm run compile:fast-paste\" \"npm run compile:winkeys\" \"npm run compile:linuxkeys\" \"npm run compile:winpaste\" \"npm run compile:linux-paste\" \"npm run compile:linux-system-audio\" \"npm run compile:text-monitor\" \"npm run compile:media-remote\" \"npm run compile:mic-listener\" \"npm run compile:audio-tap\" \"npm run compile:wincopy\"",
    "prestart": "concurrently -n compile,aec,embedding,vad \"npm run compile:native\" \"npm run download:meeting-aec-helper\" \"npm run download:embedding-model\" \"npm run download:whisper-vad-model\"",
    "start": "electron .",
    "predev": "concurrently -n compile,aec,embedding,vad \"npm run compile:native\" \"npm run download:meeting-aec-helper\" \"npm run download:embedding-model\" \"npm run download:whisper-vad-model\"",
    "dev": "concurrently -k -r \"npm:dev:renderer\" \"npm:dev:main\"",
    "predev:main": "concurrently -n compile,aec,embedding,vad \"npm run compile:native\" \"npm run download:meeting-aec-helper\" \"npm run download:embedding-model\" \"npm run download:whisper-vad-model\"",
    "dev:main": "cross-env NODE_ENV=development node scripts/run-electron.js --dev",
    "dev:renderer": "cd src && vite",
    "prebuild": "concurrently -n compile,whisper,llama,sherpa,aec,vad,embedding,diarization \"npm run compile:native\" \"npm run download:whisper-cpp\" \"npm run download:llama-server\" \"npm run download:sherpa-onnx\" \"npm run download:meeting-aec-helper\" \"npm run download:whisper-vad-model\" \"npm run download:embedding-model -- --for-build\" \"npm run download:diarization-models -- --output-dir resources/bin/diarization-models\"",
    "build": "cd src && vite build && cd .. && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "build:renderer": "cd src && vite build",
    "compile:mac-icon": "node scripts/compile-macos-icon.js",
    "prebuild:mac": "concurrently -n compile,icon,whisper,llama,sherpa,aec,vad,diarization \"npm run compile:native\" \"npm run compile:mac-icon\" \"npm run download:whisper-cpp\" \"npm run download:llama-server\" \"npm run download:sherpa-onnx\" \"npm run download:meeting-aec-helper\" \"npm run download:whisper-vad-model\" \"npm run download:diarization-models -- --output-dir resources/bin/diarization-models\"",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:mac:arm64": "npm run build:renderer && electron-builder --mac --arm64",
    "build:mac:x64": "npm run build:renderer && electron-builder --mac --x64",
    "prebuild:win": "concurrently -n compile,whisper,llama,sherpa,aec,vad,diarization,nircmd,winmic \"npm run compile:native\" \"npm run download:whisper-cpp\" \"npm run download:llama-server\" \"npm run download:sherpa-onnx\" \"npm run download:meeting-aec-helper\" \"npm run download:whisper-vad-model\" \"npm run download:diarization-models -- --output-dir resources/bin/diarization-models\" \"npm run download:nircmd\" \"npm run download:windows-mic-listener\" && npm run download:windows-fast-paste",
    "build:win": "npm run build:renderer && electron-builder --win",
    "prebuild:linux": "concurrently -n compile,whisper,llama,sherpa,aec,vad,diarization \"npm run compile:native\" \"npm run download:whisper-cpp\" \"npm run download:llama-server\" \"npm run download:sherpa-onnx\" \"npm run download:meeting-aec-helper\" \"npm run download:whisper-vad-model\" \"npm run download:diarization-models -- --output-dir resources/bin/diarization-models\"",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "build:linux:appimage": "npm run build:renderer && electron-builder --linux AppImage",
    "build:linux:deb": "npm run build:renderer && electron-builder --linux deb",
    "build:linux:rpm": "npm run build:renderer && electron-builder --linux rpm",
    "build:linux:tar": "npm run build:renderer && electron-builder --linux tar.gz",
    "prepack": "npm run compile:native && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx && npm run download:meeting-aec-helper && npm run download:whisper-vad-model && npm run download:diarization-models -- --output-dir resources/bin/diarization-models",
    "pack": "npm run build:renderer && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "predist": "npm run compile:native && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx && npm run download:meeting-aec-helper && npm run download:whisper-vad-model && npm run download:diarization-models -- --output-dir resources/bin/diarization-models",
    "dist": "npm run build:renderer && electron-builder",
    "export:dataset": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/export-dataset.js",
    "download:whisper-cpp": "node scripts/download-whisper-cpp.js --current",
    "download:whisper-cpp:all": "node scripts/download-whisper-cpp.js --all",
    "download:llama-server": "node scripts/download-llama-server.js --current",
    "download:llama-server:all": "node scripts/download-llama-server.js --all",
    "download:sherpa-onnx": "node scripts/download-sherpa-onnx.js --current",
    "download:sherpa-onnx:all": "node scripts/download-sherpa-onnx.js --all",
    "download:nircmd": "node scripts/download-nircmd.js",
    "download:windows-fast-paste": "node scripts/download-windows-fast-paste.js",
    "download:windows-key-listener": "node scripts/download-windows-key-listener.js",
    "download:windows-mic-listener": "node scripts/download-windows-mic-listener.js",
    "download:meeting-aec-helper": "node scripts/download-meeting-aec-helper.js --current",
    "download:meeting-aec-helper:all": "node scripts/download-meeting-aec-helper.js --all",
    "download:embedding-model": "node scripts/download-minilm.js",
    "download:diarization-models": "node scripts/download-diarization-models.js",
    "download:whisper-vad-model": "node scripts/download-whisper-vad-model.js",
    "format:js": "eslint . --fix && cd src && eslint . --fix && prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format": "npm run format:js",
    "format:check": "eslint . && cd src && eslint . && prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint": "eslint . && cd src && eslint .",
    "typecheck": "cd src && tsc --noEmit",
    "test": "npm run test:ui && npm run test:main",
    "test:ui": "cd src && vitest run",
    "test:main": "node --test \"test/**/*.test.js\"",
    "test:watch": "cd src && vitest",
    "quality-check": "npm run format:check && npm run typecheck",
    "i18n:check": "node scripts/check-i18n.js",
    "preview": "cd src && vite preview",
    "clean": "node cleanup.js"
  },
  "keywords": [
    "dictation",
    "speech-to-text",
    "whisper",
    "whisper.cpp",
    "electron",
    "desktop-app"
  ],
  "author": {
    "name": "Rushikesh Jaisur",
    "email": "rushikeshjaisur11@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/notarize": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.10",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.57",
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/azure": "^4.0.43",
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/google-vertex": "^5.0.54",
    "@ai-sdk/groq": "^4.0.28",
    "@ai-sdk/openai": "^4.0.18",
    "@aws-sdk/credential-providers": "^3.1111.0",
    "@better-auth/sso": "1.6.29",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@napi-rs/keyring": "^1.3.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-virtual": "^3.14.9",
    "@tiptap/core": "3.30.1",
    "@tiptap/extension-placeholder": "3.30.1",
    "@tiptap/extension-task-item": "3.30.1",
    "@tiptap/extension-task-list": "3.30.1",
    "@tiptap/react": "3.30.1",
    "@tiptap/starter-kit": "3.30.1",
    "ai": "^7.0.66",
    "better-auth": "1.6.29",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dbus-next": "^0.10.2",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "^5.2.0",
